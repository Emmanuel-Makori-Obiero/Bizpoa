# Supabase Auth for the dashboard
# The URL and publishable key are public client configuration, not secrets.
SUPABASE_URL=https://acppowzflfldjqarovzu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_mb1teflEfSt5fmknmJ22RA_J9MADwiE
# Set this to the one email allowed to use the Bizpoa dashboard.
BIZPOA_ADMIN_EMAIL=
# Business owners use their Bizpoa ID + registered phone + SMS one-time code.
# Use a random secret of at least 32 characters; keep it only in the backend environment.
BIZPOA_OWNER_SESSION_SECRET=
# Set to the public HTTPS origin of this Node backend for expiring CSV links sent by SMS.
BIZPOA_PUBLIC_URL=
# Use a separate random secret of at least 32 characters to sign 24-hour CSV links.
BIZPOA_STATEMENT_SECRET=
# Optional frontend overrides; the client has the project's public values as defaults.
VITE_SUPABASE_URL=https://acppowzflfldjqarovzu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mb1teflEfSt5fmknmJ22RA_J9MADwiE

# Gemini AI transaction review and SMS assistant. This Node backend reads this variable;
# a key saved only in Supabase Edge Function Secrets is not automatically available here.
GEMINI_API_KEY=
# Optional. Defaults to the model configured in src/voice-review.js.
# BIZPOA_AI_MODEL=

# Africa's Talking outbound SMS. Sandbox is the safe default.
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
# Optional sender ID if your AT sandbox account requires one.
# AT_SMS_FROM=YOUR-SENDER-ID

PORT=3000
# DATA_FILE=./data/bizpoa.json
