# Webhook settings
PORT=3000
# DATA_FILE=./data/bizpoa.json

# Africa's Talking outbound SMS. Sandbox is the safe default.
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
# Optional sender ID if your AT sandbox account requires one.
# AT_SMS_FROM=YOUR-SENDER-ID

# Required to unlock the local admin dashboard API.
BIZPOA_ADMIN_TOKEN=

# Gemini AI command review. Keep the key only in backend/server environment settings.
# Get a key from Google AI Studio, then set GEMINI_API_KEY in .env or Vercel project settings.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# BIZPOA_AI_MODEL=gemini-3.8-flash
